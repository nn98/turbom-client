# Unset (or empty) = demo mode: all data comes from the built-in mock backend
# (src/lib/api/mock-*.ts), no network calls are made.
# Set = every call in src/lib/api/client.ts goes to the real backend below,
# using the contract in docs/spec/api-spec.md.
# VITE_API_BASE_URL=https://turbom.duckdns.org

# Kakao Developers "JavaScript" key (safe to expose to the browser — NOT the
# REST API key or Native App key, those are for server-side/mobile SDK use
# and unused here). Required for src/components/map-view.tsx to render. Get
# one at https://developers.kakao.com > 내 애플리케이션 > 앱 키, and register
# every domain you run this app on (including localhost:PORT for local dev)
# under 플랫폼 > Web, or the map will fail to load.
# VITE_KAKAO_MAP_JS_KEY=
