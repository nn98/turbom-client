# Unset (or empty) = demo mode: all data comes from the built-in mock backend
# (src/lib/api/mock-*.ts), no network calls are made.
# Set = every call in src/lib/api/client.ts goes to the real backend below,
# using the contract in docs/spec/api-spec.md.
# VITE_API_BASE_URL=https://turbom.duckdns.org

# Naver Cloud Platform Maps "Client ID" (this is the JavaScript key, safe to
# expose to the browser — NOT the REST API/Client Secret key). Required for
# src/components/map-view.tsx to render. Get one at
# https://console.ncloud.com > AI·NAVER API > Maps, and add every domain you
# run this app on (including localhost:PORT for local dev) under the
# application's Web Service URL allowlist, or the map will fail to load.
# VITE_NAVER_MAP_CLIENT_ID=
